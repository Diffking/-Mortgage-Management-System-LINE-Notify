# ================================================
# SPSC loanEasy v1.0 - Environment Configuration
# Copy this file to .env and fill in your values
# ================================================

# Application Mode: dev | prod
APP_MODE=dev

# Server Port
PORT=3000

# ================================================
# DEV Database Configuration
# ================================================
DEV_DB_HOST=localhost
DEV_DB_PORT=3306
DEV_DB_USER=root
DEV_DB_PASS=your_dev_password
DEV_DB_NAME=spsccoop_webt2app

# ================================================
# PROD Database Configuration
# ================================================
PROD_DB_HOST=your_prod_host
PROD_DB_PORT=3306
PROD_DB_USER=prod_user
PROD_DB_PASS=your_prod_password
PROD_DB_NAME=spsccoop_webt2app

# ================================================
# JWT Configuration (Phase 2)
# ================================================
DEV_JWT_SECRET=your_dev_jwt_secret_at_least_32_chars
DEV_JWT_REFRESH_SECRET=your_dev_refresh_secret_at_least_32_chars

PROD_JWT_SECRET=your_prod_jwt_secret_must_be_very_long_and_random
PROD_JWT_REFRESH_SECRET=your_prod_refresh_secret_must_be_very_long

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# ================================================
# Cookie Configuration (Phase 2)
# ================================================
DEV_COOKIE_SECURE=false
PROD_COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ================================================
# LINE Notify Configuration (Phase 4)
# ================================================
# Get token from: https://notify-bot.line.me/
LINE_NOTIFY_TOKEN=your_line_notify_token_here

# ================================================
# Security Configuration (Phase 5B)
# ================================================
# Comma-separated list of allowed origins for CORS (Production)
# Example: https://loaneasy.spsc.or.th,https://admin.spsc.or.th
ALLOWED_ORIGINS=https://loaneasy.spsc.or.th
