# ================================================
# SPSC loanEasy v1.0 - Environment Configuration
# Single ENV file for Dev/Prod
# ================================================

# Application Mode: dev | prod
APP_MODE=dev

# Server Port
PORT=3000

# ================================================
# DEV Database Configuration
# ================================================
DEV_DB_HOST=localhost
DEV_DB_PORT=3306
DEV_DB_USER=root
DEV_DB_PASS=""
DEV_DB_NAME=loaneasy

# ================================================
# PROD Database Configuration
# ================================================
PROD_DB_HOST=127.0.0.1
PROD_DB_PORT=3306
PROD_DB_USER=prod_user
PROD_DB_PASS=prod_pass
PROD_DB_NAME=spsccoop_webt2app

# ================================================
# JWT Configuration (Phase 2)
# ================================================
DEV_JWT_SECRET=dev_secret_key_change_me_in_production
DEV_JWT_REFRESH_SECRET=dev_refresh_secret_key_change_me

PROD_JWT_SECRET=prod_secret_key_must_be_very_long_and_random
PROD_JWT_REFRESH_SECRET=prod_refresh_secret_key_must_be_very_long

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# ================================================
# Cookie Configuration (Phase 2)
# ================================================
DEV_COOKIE_SECURE=false
PROD_COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
